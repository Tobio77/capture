APP_NAME=Capture
APP_ENV=e2e
APP_KEY=base64:BxllstSDhe303/kKSRLoRNUV/gPiRf/FZxTymuKWOPQ=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Basis data KHUSUS pengujian E2E (Playwright) — berkas SQLite terpisah
# total dari `database/database.sqlite` (dev) dan dari MySQL `capture`
# (produksi/dev nyata). `tests/e2e/global-setup.js` menghapus dan mengisi
# ulang berkas ini di awal setiap kali suite dijalankan; lihat juga
# `App\Console\Commands\SiapkanE2ECommand` yang MENOLAK berjalan kecuali
# path ini yang aktif.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# http di lokal/CI, bukan https — lihat catatan yang sama pada .env.example.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=array

VITE_APP_NAME="${APP_NAME}"

# WORKA tidak pernah sungguhan dihubungi dari test E2E (lihat rencana
# cakupan di tests/e2e/README.md) — nilai di bawah sengaja tidak valid.
WORKA_API_URL=http://worka.invalid
WORKA_API_TOKEN=
WORKA_API_TIMEOUT=5
WORKA_SYNC_INTERVAL=1440

PROXY_TEPERCAYA=
